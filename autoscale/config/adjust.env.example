# Copy to /etc/plc-edgeflow/adjust.env and set ownership root:plcmon, mode 0640.
PLC_CONFIG=/etc/plc-edgeflow/machines.yaml
PLC_INTERVAL=60
PLC_METRICS_HOST=127.0.0.1
PLC_METRICS_PORT=9108

PLC_MQTT_BROKER=mqtt.factory.example
PLC_MQTT_PORT=8883
PLC_MQTT_USERNAME=plc-edgeflow
PLC_MQTT_PASSWORD_FILE=/etc/plc-edgeflow/secrets/mqtt-password
PLC_MQTT_TLS=true
PLC_MQTT_CA_FILE=/etc/plc-edgeflow/pki/factory-ca.pem
# Optional mutual TLS credentials:
# PLC_MQTT_CERT_FILE=/etc/plc-edgeflow/pki/client.pem
# PLC_MQTT_KEY_FILE=/etc/plc-edgeflow/pki/client-key.pem
# Never enable PLC_MQTT_TLS_INSECURE in production.
PLC_MQTT_TLS_INSECURE=false
PLC_REQUIRE_SECURE_MQTT=true

PLC_DECODER_PROCESSOR=sqlite
PLC_DECODER_SQLITE_PATH=/var/lib/plc-edgeflow/points.db
PLC_DECODER_DLQ_PATH=/var/lib/plc-edgeflow/decoder-dlq.db
PLC_DECODER_CRASH_THRESHOLD=3
PLC_DECODER_RESTART_BACKOFF_WINDOW=60
